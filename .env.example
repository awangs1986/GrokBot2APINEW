HOST=127.0.0.1
PORT=8793
GROKBOT2API_KEY=change-me
GROKBOT_MODEL=grok-4.5
GROKBOT_UPSTREAM_MODEL=grok-4.5
GROKBOT_CLIENT_VERSION=0.30.0

# Upstream protocol mode. "inference" is the original implementation.
# "ai-stream-chat" uses the desktop AiService StreamChat endpoint and currently
# supports text chat only (no Pi/Grok CLI tools).
# GROKBOT_UPSTREAM_MODE=ai-stream-chat

# "grokbot-service" is the current desktop 0.30.0 message/transcript route.
# Each stable Pi session creates its own Bot; mappings survive restarts.
# It supports text requests only while Pi tool transcript handling is verified.
# GROKBOT_UPSTREAM_MODE=grokbot-service
# GROKBOT_SESSION_STORE=/home/user/.config/grokbot2api/sessions.json
# GROKBOT_AGENT_POLL_INTERVAL_MS=500
# GROKBOT_SERVICE_BACKEND=https://api2.cursor.sh/aiserver.v1.GrokBotService/

# Request JSON body cap in bytes. Default: 1048576 (1 MiB). Hard max: 16777216.
# Increase explicitly for Grok CLI/agent requests with large tool schemas.
# GROKBOT_MAX_BODY_BYTES=8388608

# In-process cooldown after upstream 429/resource_exhausted. Default: 30000.
# Set to 0 to disable. Hard max: 300000.
# GROKBOT_RATE_LIMIT_COOLDOWN_MS=30000

# Linux/manual bootstrap path. Prefer short-lived files owned by the service user.
# The sidecar reads credentials on every request and never writes this file.
# {
#   "accessToken": "eyJ...",
#   "machineId": "...",
#   "clientVersion": "0.30.0"
# }
# GROKBOT_CREDENTIALS_FILE=/run/grokbot2api/credentials.json

# Linux refresh path. The command must be an absolute path and must print only:
# {"accessToken":"eyJ...","machineId":"...","clientVersion":"0.30.0"}
# It runs without a shell on every request, so an external Grok Bot/runtime helper
# can refresh credentials without this service storing tokens.
# GROKBOT_CREDENTIALS_COMMAND=/usr/local/lib/grokbot2api/credentials-helper.mjs
# GROKBOT_CREDENTIALS_COMMAND_TIMEOUT_MS=5000

# Linux desktop Grok Bot: when ~/.config/Grok Bot/sand-secrets.json and the
# "Grok Bot" Secret Service keyring item are available, credentials load
# automatically. Override this path only for a separate desktop profile.
# GROKBOT_LINUX_SECRETS_PATH=/home/user/.config/Grok Bot/sand-secrets.json

# Direct env fallback for isolated tests only.
# GROKBOT_ACCESS_TOKEN=
# GROKBOT_MACHINE_ID=

# Non-loopback bind is blocked unless this is explicit.
# GROKBOT_ALLOW_PRIVATE_BIND=1
